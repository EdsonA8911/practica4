# Copia este archivo a .env y ajusta los valores (no subas .env a Git).
# Flask carga variables de entorno automáticamente si usas python-dotenv, o exporta en la shell.

# Obligatorio en producción: clave larga y aleatoria
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga

# MySQL (coherente con docker-compose.yml en desarrollo)
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:@127.0.0.1:3306/appdashboard
